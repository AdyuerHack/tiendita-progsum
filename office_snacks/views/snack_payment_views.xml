<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_snack_payment_list" model="ir.ui.view">
            <field name="name">office.snack.payment.list</field>
            <field name="model">office.snack.payment</field>
            <field name="arch" type="xml">
                <list string="Pagos" create="false" decoration-info="state == 'pending'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                    <field name="evidence" widget="image" options="{'size': [50, 50], 'zoom': true}"/>
                    <field name="consumer_id"/>
                    <field name="amount" widget="monetary"/>
                    <field name="currency_id" column_invisible="True"/>
                    <field name="create_date" string="Fecha"/>
                    <field name="state" widget="badge"/>
                    <button name="action_approve" type="object" string="Aprobar" class="oe_highlight" invisible="state != 'pending'" icon="fa-check"/>
                </list>
            </field>
        </record>

        <record id="view_snack_payment_form" model="ir.ui.view">
            <field name="name">office.snack.payment.form</field>
            <field name="model">office.snack.payment</field>
            <field name="arch" type="xml">
                <form string="Pago" create="false" edit="false">
                    <header>
                        <button name="action_approve" type="object" string="Aprobar Pago" class="btn-primary" invisible="state != 'pending'"/>
                        <button name="action_reject" type="object" string="Rechazar" class="btn-secondary" invisible="state != 'pending'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="consumer_id"/>
                                <field name="amount" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="create_date" string="Fecha de Reporte"/>
                                <field name="evidence" widget="image" options="{'size': [250, 250], 'zoom': true}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Consumos Pagados">
                                <field name="consumption_ids">
                                    <list>
                                        <field name="product_id"/>
                                        <field name="quantity"/>
                                        <field name="total_price" widget="monetary"/>
                                        <field name="currency_id" column_invisible="True"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
