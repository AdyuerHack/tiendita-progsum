<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Acciones principales -->
        <record id="action_snack_product" model="ir.actions.act_window">
            <field name="name">Mis Snacks</field>
            <field name="res_model">office.snack.product</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Añade tu primer Snack.
                </p>
            </field>
        </record>

        <record id="action_snack_consumption" model="ir.actions.act_window">
            <field name="name">Consumos</field>
            <field name="res_model">office.snack.consumption</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_snack_payment" model="ir.actions.act_window">
            <field name="name">Pagos Recibidos</field>
            <field name="res_model">office.snack.payment</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menús -->
        <menuitem id="menu_office_snacks_root" name="Office Snacks" sequence="30" groups="office_snacks.group_snack_owner,base.group_system"/>
        
        <menuitem id="menu_office_snacks_product" name="Productos" parent="menu_office_snacks_root" action="action_snack_product" sequence="10"/>
        <menuitem id="menu_office_snacks_consumption" name="Consumos" parent="menu_office_snacks_root" action="action_snack_consumption" sequence="20"/>
        <menuitem id="menu_office_snacks_payment" name="Pagos" parent="menu_office_snacks_root" action="action_snack_payment" sequence="30"/>
    </data>
</odoo>
