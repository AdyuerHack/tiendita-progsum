<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_snack_product_list" model="ir.ui.view">
            <field name="name">office.snack.product.list</field>
            <field name="model">office.snack.product</field>
            <field name="arch" type="xml">
                <list string="Productos" decoration-muted="not active" decoration-danger="stock &lt;= 0" editable="bottom">
                    <field name="name"/>
                    <field name="category_id"/>
                    <field name="price" widget="monetary"/>
                    <field name="currency_id" column_invisible="True"/>
                    <field name="stock"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_snack_product_kanban" model="ir.ui.view">
            <field name="name">office.snack.product.kanban</field>
            <field name="model">office.snack.product</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="id"/>
                    <field name="name"/>
                    <field name="image"/>
                    <field name="price"/>
                    <field name="currency_id"/>
                    <field name="stock"/>
                    <field name="category_id"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <field name="image" widget="image"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <div class="o_kanban_tags_section">
                                        <span class="badge rounded-pill text-bg-info"><field name="category_id"/></span>
                                    </div>
                                    <div class="mt-1">
                                        Precio: <field name="price" widget="monetary"/>
                                    </div>
                                    <div t-attf-class="mt-1 fw-bold #{record.stock.raw_value &lt;= 0 ? 'text-danger' : 'text-success'}">
                                        Stock: <field name="stock"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_snack_product_form" model="ir.ui.view">
            <field name="name">office.snack.product.form</field>
            <field name="model">office.snack.product</field>
            <field name="arch" type="xml">
                <form string="Producto">
                    <sheet>
                        <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" invisible="active"/>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <label for="name" string="Nombre del Snack"/>
                            <h1><field name="name" placeholder="Ej. Papitas"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="category_id"/>
                                <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="currency_id" invisible="True"/>
                                <field name="owner_id"/>
                            </group>
                            <group>
                                <field name="stock"/>
                                <field name="active" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
