<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Categoría de Seguridad -->
        <record id="module_category_office_snacks" model="ir.module.category">
            <field name="name">Office Snacks</field>
            <field name="description">Gestión de venta de snacks basados en la confianza</field>
            <field name="sequence">20</field>
        </record>

        <!-- Grupo de Dueños de Snacks -->
        <record id="group_snack_owner" model="res.groups">
            <field name="name">Dueño de Snacks</field>
            <field name="category_id" ref="module_category_office_snacks"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">El usuario puede administrar sus propios snacks, consumos y pagos.</field>
        </record>

        <!-- Reglas de Registro (Record Rules) -->

        <!-- El dueño solo ve y edita sus propios productos -->
        <record id="rule_snack_product_owner" model="ir.rule">
            <field name="name">Dueño solo gestiona sus snacks</field>
            <field name="model_id" ref="model_office_snack_product"/>
            <field name="domain_force">[('owner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_snack_owner'))]"/>
        </record>

        <!-- El administrador ve todos los productos -->
        <record id="rule_snack_product_admin" model="ir.rule">
            <field name="name">Admin gestiona todos los snacks</field>
            <field name="model_id" ref="model_office_snack_product"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <!-- El dueño solo ve consumos vinculados a él -->
        <record id="rule_snack_consumption_owner" model="ir.rule">
            <field name="name">Dueño solo ve sus consumos</field>
            <field name="model_id" ref="model_office_snack_consumption"/>
            <field name="domain_force">[('owner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_snack_owner'))]"/>
        </record>

        <record id="rule_snack_consumption_admin" model="ir.rule">
            <field name="name">Admin ve todos los consumos</field>
            <field name="model_id" ref="model_office_snack_consumption"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <!-- El dueño solo ve pagos dirigidos a él -->
        <record id="rule_snack_payment_owner" model="ir.rule">
            <field name="name">Dueño solo gestiona sus pagos</field>
            <field name="model_id" ref="model_office_snack_payment"/>
            <field name="domain_force">[('owner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_snack_owner'))]"/>
        </record>

        <record id="rule_snack_payment_admin" model="ir.rule">
            <field name="name">Admin ve todos los pagos</field>
            <field name="model_id" ref="model_office_snack_payment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

    </data>
</odoo>
